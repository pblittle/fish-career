{
  "name": "fish-career",
  "version": "0.4.0",
  "description": "Rank remote job postings against a profile you trust. Reads the public ATS boards directly, scores arrivals with typed weighted questions, and measures whether the ranking agrees with your own judgment.",
  "keywords": [
    "job",
    "career",
    "mcp",
    "mcp-server",
    "jev",
    "ats"
  ],
  "license": "MIT",
  "author": "Little Bets, LLC",
  "type": "module",
  "bin": {
    "fish-career": "dist/index.js"
  },
  "files": [
    "dist",
    "demo"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "biome check ..",
    "lint:fix": "biome check --write .."
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  }
}
