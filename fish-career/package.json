{
  "name": "fish-career",
  "version": "0.3.0",
  "description": "A local-first MCP server that finds job opportunities, interprets their fit, scores them with an explicit rubric, and hones that rubric against human judgment.",
  "keywords": [
    "job-search",
    "career",
    "mcp",
    "mcp-server",
    "ats",
    "greenhouse",
    "ashby",
    "lever",
    "smartrecruiters",
    "local-first",
    "typescript",
    "jev"
  ],
  "license": "MIT",
  "author": "Little Bets, LLC",
  "type": "module",
  "bin": {
    "fish-career": "dist/index.js",
    "fish": "dist/index.js"
  },
  "files": [
    "dist",
    "demo"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pblittle/fish-career.git"
  },
  "homepage": "https://github.com/pblittle/fish-career#readme",
  "bugs": {
    "url": "https://github.com/pblittle/fish-career/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "biome check ..",
    "lint:fix": "biome check --write ..",
    "lint:md": "markdownlint-cli2 --config ../.markdownlint-cli2.jsonc \"../*.md\" \"../docs/**/*.md\" \"../specs/**/*.md\" \"README.md\"",
    "verify:pack": "node scripts/verify-pack.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@types/node": "^26.6.2",
    "markdownlint-cli2": "^0.19.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  }
}
