{
  "name": "fish-career",
  "version": "0.8.0",
  "description": "Local-first job search: an MCP server and CLI that rank postings against your profile, explain every score, and measure the ranking against your own judgment.",
  "keywords": [
    "job-search",
    "career",
    "mcp",
    "mcp-server",
    "jev",
    "ats"
  ],
  "license": "MIT",
  "author": "Little Bets, LLC",
  "type": "module",
  "bin": {
    "fish-career": "dist/index.js",
    "fish": "dist/index.js"
  },
  "files": [
    "dist",
    "eval"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pblittle/fish-career.git"
  },
  "homepage": "https://github.com/pblittle/fish-career#readme",
  "bugs": {
    "url": "https://github.com/pblittle/fish-career/issues"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "biome check ..",
    "lint:fix": "biome check --write ..",
    "lint:md": "markdownlint-cli2 --config ../.markdownlint-cli2.jsonc \"../*.md\" \"../docs/**/*.md\" \"../specs/**/*.md\" \"README.md\"",
    "verify:pack": "node scripts/verify-pack.mjs",
    "smoke": "node scripts/smoke-stdio.mjs",
    "quality": "node dist/index.js quality",
    "record:eval": "node scripts/record-eval-baseline.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "health": "npm run lint && npm run typecheck && npm run test && npm run lint:md && npm run build && npm run verify:pack && npm run check:boundaries",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^26.6.2",
    "markdownlint-cli2": "^0.23.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
