    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  }
}
