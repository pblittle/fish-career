{
  "name": "fish-mcp",
  "version": "0.2.0",
  "description": "MCP server for fish: watch company ATS boards, fetch remote postings, triage them against a profile with Jev",
  "license": "MIT",
  "author": "Little Bets, LLC",
  "type": "module",
  "bin": {
    "fish-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
