TYPESAFE_API_KEY=your-key-from-https://console.typesafe.ai/keys

# No key yet? The deterministic stand-in judge answers the same typed
# questions from inspectable string rules, so the loop runs end to end:
# FISH_JUDGE=fake

# Optional: mirror judge-call traces to LangSmith. The local JSONL trace
# (FISH_HOME/state/traces.jsonl) is always written and remains the source of
# truth; the mirror carries posting IDs, hashes, model, tokens, and answers,
# never the posting text or your profile text.
# FISH_TRACE=langsmith
# LANGSMITH_API_KEY=your-key-from-https://smith.langchain.com
# LANGSMITH_PROJECT=fish-career
